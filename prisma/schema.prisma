// EstimateIQ data model.
// Provider is SQLite for local-first dev; swap to postgresql for Supabase/prod
// by changing `provider` + DATABASE_URL. SQLite doesn't support Prisma enums,
// so enum-like columns are String with allowed values enforced in TS
// (see lib/types.ts). JSON blobs are stored as String for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  name           String?
  passwordHash   String?
  /// Avatar URL — never image bytes. The bytes live behind `lib/storage`, whose
  /// `put()` returns whatever URL its provider serves from: `/api/avatar/<id>`
  /// for the built-in database store, a CDN URL for an external one. Holding a
  /// URL rather than a data URI is what keeps a 30 KB avatar out of every RSC
  /// payload, since `getSessionUser()` returns this whole row on every page.
  image          String?
  /// "user" | "professor" | "admin" — see USER_ROLES in lib/types.ts.
  ///
  /// A professor may open classroom rooms and nothing else; the admin panel
  /// stays admin-only. One column rather than a second boolean, so "what is this
  /// person" has exactly one answer.
  role           String    @default("user")
  isGuest        Boolean   @default(false)

  /// Pro access runs until this instant, or null for a free account.
  ///
  /// The single source of truth for the paid tier, which is why the old `plan`
  /// column is gone rather than kept alongside it. `tierFor()` compares this
  /// against now, so a lapsed pass downgrades itself: there is no cron, no
  /// renewal job, and nothing that can fall out of sync with a stored label.
  proUntil       DateTime?

  // gamification
  xp             Int       @default(0)
  level          Int       @default(1)
  coins          Int       @default(0)
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  // percentile rank (cached; recomputed on a schedule)
  rank           String?   // "Silver" | "Gold" | "Platinum" | "Diamond" | null
  percentile     Float?
  skillRating    Float?

  /// Has seen the first-run tutorial on the PRACTICE screen. Not a signup
  /// marker — see `profileCompletedAt`, which is the one that is.
  onboardedAt    DateTime?
  /// Has been through the post-signup questions (or skipped them deliberately).
  /// Named apart from `onboardedAt` because the two are genuinely different
  /// events and sharing one column would silently suppress the practice
  /// tutorial for anyone who filled in their profile.
  profileCompletedAt DateTime?

  /// Curated college id from `lib/config/colleges.ts`, or null for "Other" /
  /// not answered — in which case the written-in name is on `Profile`.
  ///
  /// On User rather than Profile, and indexed, because grouping by it is a
  /// query rather than a display: a college leaderboard reads this beside
  /// `skillRating`, which lives here too, so it stays a single indexed scan
  /// with no join.
  collegeId      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attempts       Attempt[]
  bookmarks      Bookmark[]
  achievements   UserAchievement[]
  feedback       QuestionFeedback[]
  progress       Progress?
  profile        Profile?
  simRuns        SimRun[]
  simOverrides   SimScenarioOverride[]
  ranked         LeaderboardEntry[]
  hostedRooms    SimRoom[]             @relation("HostedRooms")
  roomSeats      SimRoomMember[]

  @@index([collegeId])
}

/// The parts of a person the app displays but never queries by.
///
/// A side table rather than more columns on `User`, for one reason:
/// `getSessionUser()` returns the entire `User` row and is called on essentially
/// every page in the app. A bio, a phone number and — decisively — a base64
/// avatar sitting there would be serialised into every RSC payload the app ever
/// sends, to render a header that needs none of them.
///
/// So the split is by access pattern, not by how "profile-ish" a field feels:
/// anything queried, ranked or filtered by stays on `User` (`collegeId`,
/// `skillRating`), and anything read only when someone opens their own profile
/// lives here. `Progress` is the same shape for the same kind of reason.
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone     String?
  city      String?
  bio       String?

  /// One of PROFESSIONS in lib/config/profile.ts.
  profession String?
  /// Written-in college, set only when `User.collegeId` is null. It deliberately
  /// gets no grouping key: an uncurated name cannot be grouped reliably, which
  /// is the whole reason the curated list exists.
  collegeOther String?
  gradYear  Int?
  /// One of EXPERIENCE_BANDS in lib/config/profile.ts.
  experience String?

  /// JSON string[] of INTERVIEW_LEVELS. Read by `recommendQuestions` and used
  /// as the library's default filter, so answering it changes what the app
  /// shows rather than only what the profile page prints.
  targetLevels String @default("[]")
  /// Free text — "McKinsey, Flipkart". Never parsed, only displayed.
  targetCompanies String?

  /// Base64 image bytes, written only by the `db` avatar store. Absent when an
  /// external store is configured, since the bytes then live there and
  /// `User.image` points at it instead.
  avatarData String?
  avatarMime String?
  /// Bumped on every upload and put in the served URL's query string, so an
  /// immutable cache header is safe.
  avatarVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  order       Int        @default(0)
  questions   Question[]
}

model Question {
  id             String   @id @default(cuid())
  title          String
  prompt         String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  difficulty     String   // "Easy" | "Medium" | "Hard"
  interviewLevel String   // "BCG" | "McKinsey" | "Bain" | "Big4" | "PM" | "Product" | "GeneralMBA"
  type           String   @default("guesstimate") // "guesstimate" | "qualitative" | "case"

  /// The industry the question is set in — a `SECTORS` value from lib/types.ts.
  ///
  /// Its own column rather than a second category, because `categoryId` answers
  /// "what technique is this?" and this answers "what business is it about?".
  /// One FK cannot hold both, and merging them is what made the old catalogue
  /// dropdown a list of two unrelated things.
  ///
  /// Nullable so a CSV import that omits it is a question without a sector
  /// rather than a failed row; the seed fills every one.
  sector         String?

  idealLow       Float?
  idealHigh      Float?
  unit           String?

  /// Slug of the framework this case is written against ("profitability",
  /// "market-entry", …). The strongest signal for deciding which framework a
  /// candidate is building, and authored rather than inferred.
  framework      String?
  /// JSON array of buckets a good answer covers, used by MECE coverage scoring.
  expectedBuckets String?
  /// JSON array of facts the interviewer releases only when asked about that
  /// branch: [{ "topic": ["cost","delivery"], "fact": "…" }]. Injecting these
  /// stops the model inventing figures that contradict the sample solution.
  dataPack       String?
  /// JSON { "path": ["Cost","Delivery cost"], "note": "…" } — the branch that
  /// actually holds the problem. Its presence is what makes a question
  /// diagnostic; without it there is no diagnosis score.
  rootCause      String?

  betterApproach String   @default("")
  sampleSolution String   @default("")
  tags           String?  // comma-separated

  /// Reachable without an account. The library's shop window: a guest gets the
  /// questions flagged here and nothing else (see lib/entitlements.ts).
  ///
  /// Deliberately outside the authoring contract in lib/question-schema.ts.
  /// Whether a question is *good* and whether it is *given away* are different
  /// decisions, and folding the flag into `toQuestionColumns` would mean every
  /// admin edit and every CSV re-import silently reset the free tier to false.
  /// It is written only by `setQuestionFreeTier` and the seed.
  freeTier       Boolean  @default(false)

  source         String   @default("seed") // "seed" | "admin" | "import" | "llm"
  sourceUrl      String?
  externalId     String?  @unique

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempts       Attempt[]
  bookmarks      Bookmark[]
  feedback       QuestionFeedback[]
  simRuns        SimRun[]
  ranked         LeaderboardEntry[]
  rooms          SimRoom[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([interviewLevel])
  @@index([sector])
}

/// A user's FIRST result on a question — the only row a leaderboard ranks.
///
/// **Insert-only, and the unique constraint is the entire first-attempt rule.**
/// A replay finds the row already there and leaves it untouched, so "only the
/// first attempt counts" is enforced by the database rather than by a check
/// every future call site has to remember. Same posture as `SimPurchase`'s
/// constraint: the integrity rule worth spending an index on is the one a retry
/// would otherwise corrupt.
///
/// The score is DENORMALISED from `Evaluation` / `SimResult` rather than joined
/// at read time, for two reasons. A leaderboard must not fan out across every
/// attempt a user ever made to find their earliest one. And pinning the number
/// here means a later re-scoring — a rubric change, a retuned scenario — cannot
/// silently rewrite a standing that people have already seen, which is the same
/// argument that pins `SimResult.outcomeJson`.
///
/// Guests get rows like anyone else; they are filtered at READ time, exactly as
/// `recomputeRank` filters them out of the percentile population. Writing them
/// is what lets a guest's history survive `claim-on-signup` intact.
model LeaderboardEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// "attempt" | "simulation" — which exercise produced the score, so a row can
  /// be badged and its effort unit formatted without a join.
  kind       String

  /// 0–100. `Evaluation.overall` or `SimResult.overall`.
  score      Int

  /// The tiebreak, and **lower is always better**: seconds taken on an attempt,
  /// analyst-days spent on a simulation. One column rather than one per kind,
  /// because the two are never compared against each other — a per-question
  /// board holds a single kind by construction.
  effort     Int      @default(0)

  /// The `Attempt.id` or `SimRun.id` this score came from.
  ///
  /// Not a foreign key — it points at one of two tables — and not used for
  /// joining. It exists so a report screen can answer "is the run I am looking
  /// at the ranked one?" by comparing ids, instead of re-deriving which attempt
  /// was earliest and risking a different answer than the write path gave.
  sourceId   String?

  /// When the ranked result was achieved. Drives the weekly board's window, and
  /// is the final tiebreak so an earlier identical result ranks ahead.
  achievedAt DateTime @default(now())

  /// The rule itself. Everything else here is presentation.
  @@unique([userId, questionId])
  @@index([questionId, score])
  @@index([achievedAt])
}

model Attempt {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])

  mode          String    @default("interviewer")
  status        String    @default("in_progress") // "in_progress" | "submitted" | "abandoned"
  timeSpentSec  Int       @default(0)
  hintsUsed     Int       @default(0)
  finalEstimate Float?
  /// The recommendation in words, for questions that don't end in a number.
  finalAnswer   String?
  /// "solo" | "guided" — how much of the tree the app offers. Fixed at creation:
  /// a mid-attempt switch would make "solo" meaningless. Null on numeric attempts.
  treeMode      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submittedAt   DateTime?

  messages      Message[]
  assumptions   Assumption[]
  calculations  Calculation[]
  framework     FrameworkNode[]
  evaluation    Evaluation?

  @@index([userId])
  @@index([questionId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  mode      String?
  content   String
  hintLevel Int?
  /// Which engine produced an assistant turn: "gemini" | "anthropic" | "openai" |
  /// "mock" | "mock (fallback)". Persisted rather than kept in client state so the
  /// UI's degraded-answer badge survives a page reload.
  provider  String?
  /// Model identifier for the turn, when the provider has one.
  model     String?
  createdAt DateTime @default(now())

  @@index([attemptId])
}

/// Deployment-wide daily counter of real LLM calls, so the app can stay inside a
/// shared free-tier quota instead of discovering the ceiling by taking 429s.
/// One row per UTC day; see `lib/llm/budget.ts`.
model UsageCounter {
  id        String   @id @default(cuid())
  /// UTC date, "YYYY-MM-DD".
  day       String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Assumption {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  key       String
  value     String
  rating    String?  // "Reasonable" | "NeedsJustification" | "Weak" | "Excellent"
  aiNote    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
}

model Calculation {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  expression String
  result     Float?
  resultText String?
  createdAt  DateTime @default(now())

  @@index([attemptId])
}

model FrameworkNode {
  id        String          @id @default(cuid())
  attemptId String
  attempt   Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  label     String
  value     String?
  /// Optional second factor, kept apart from `value` so a segment can carry a
  /// share of its parent AND its own rate ("50%" × "3 cups/day"). Blank = 1.
  multiplier String?
  /// Free-text rationale. Present in the schema from the start but only written
  /// to by qualitative attempts, where it is the optional typed alternative to a
  /// rationale inherited from chat (see `sourceMessageId`).
  note      String?
  order     Int             @default(0)
  combine   String          @default("sum") // "sum" | "multiply" — how this node's children combine (meaningful only with 2+ children)
  /// "unknown" | "healthy" | "problem" — the candidate's own judgement about this
  /// branch. Never derived from children: a red child does not redden its parent.
  status    String?
  /// The chat turn this bucket was promoted from, or the turn that revealed the
  /// fact backing it. The node's rationale is that message, so a candidate who
  /// thinks aloud never types a justification twice.
  sourceMessageId String?
  /// "manual" | "chat" | "scaffold" | "suggested" — lets scoring tell a tree the
  /// candidate built from one they accepted wholesale.
  origin    String?
  parentId  String?
  parent    FrameworkNode?  @relation("NodeChildren", fields: [parentId], references: [id])
  children  FrameworkNode[] @relation("NodeChildren")
  createdAt DateTime        @default(now())

  @@index([attemptId])
  @@index([parentId])
}

model Evaluation {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Null means the attempt was not scored at all, which is a different claim
  /// from a low score. Teacher mode states the answer, so an attempt that used
  /// it has no performance left to measure — and a number invented for it would
  /// travel into interview readiness, percentile rank and the leaderboard as
  /// though it had been earned. Every aggregate filters on `overall != null`;
  /// the per-category scores below are still written, because they are feedback
  /// the report shows rather than a measurement anything sums.
  overall       Int?
  readiness     String?

  /// Nullable categories are "not applicable to this attempt", not "scored zero".
  /// A null is skipped by the weighted mean, which renormalises over what remains,
  /// so an overall stays comparable across modes instead of being dragged down by
  /// a category the attempt could never have earned:
  ///   calculation  — null for qualitative attempts (no arithmetic)
  ///   diagnosis    — null unless the question declares a root cause
  ///   structuring, segmentation — null for guided attempts (the app built the tree)
  structuring   Int?
  logic         Int
  segmentation  Int?
  assumptions   Int
  calculation   Int?
  diagnosis     Int?
  communication Int
  business      Int
  confidence    Int

  accuracyHit   Boolean  @default(false)
  feedback      String   @default("[]") // JSON array of feedback items
  betterApproach String  @default("")
  sampleSolution String  @default("")

  createdAt     DateTime @default(now())
}

model Progress {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalSolved Int      @default(0)
  avgScore    Float    @default(0)
  accuracy    Float    @default(0)
  consistency Float    @default(0)
  byCategory  String   @default("{}") // JSON: { [categoryId]: { avg, count } }
  bySkill     String   @default("{}") // JSON: { [skillKey]: { avg, count } }

  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  emoji       String            @default("🏅")
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

/// A decision-simulation run.
///
/// Deliberately NOT an Attempt. `updateProgress` and `recomputeRank`
/// (lib/progress.ts) read Attempt + Evaluation directly, as does lib/admin-stats,
/// so a simulation that wrote an Evaluation would need an exclusion filter at
/// four-plus query sites, forever, for interview readiness to stay honest. A
/// separate table means there is no filter to forget: lib/progress.ts changes by
/// zero lines. The nine Evaluation columns are named for interview behaviours
/// anyway ("segmentation", "calculation") and would poison Progress.bySkill.
///
/// The scenario CONTENT lives in lib/sim/scenarios, keyed by `scenarioSlug`.
model SimRun {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The catalogue row, so a simulation is findable, filterable and bookmarkable
  /// alongside every other question.
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id])
  /// Denormalised from Question.externalId so a run stays readable if the
  /// catalogue row is ever re-pointed at a different scenario.
  scenarioSlug   String

  phase          String    @default("observe") // "observe" | "investigate" | "commit" | "debrief"
  /// Analyst-days spent. Derived from purchases; cached so the budget meter is
  /// a single read rather than a join on every render.
  daysSpent      Int       @default(0)

  /// JSON string[] — the cause ids currently named as suspects.
  ///
  /// Revisable throughout Investigate and settled when Commit opens: a
  /// prediction you may not update when the data contradicts it is not a
  /// hypothesis either. Holds only the CURRENT belief; the history lives in
  /// `stateJson` (see lib/sim/hypothesis-log.ts), which is what lets
  /// `scoreInvestigation` rate each pull against what was believed when it was
  /// bought rather than against whatever was claimed afterwards.
  hypothesis     String?
  hypothesisNote String?
  /// JSON string[] — cause ids named at Commit.
  diagnosis      String?
  /// JSON SimAllocationLine[] — the committed capacity split.
  allocation     String?

  /// The classroom room this run was played for, or null for solo play.
  ///
  /// Nullable and `SetNull` rather than `Cascade`: a professor tidying up after
  /// term must not delete the work sixty students did. The run outlives the room
  /// exactly as it outlives the room's `open` status — see `closeRoom`.
  ///
  /// Also the reason `findResumableRun` and `simStateByQuestion` filter on
  /// `roomId: null`. A class run and a solo run of the same scenario are two
  /// different sittings, and collapsing them would let the catalogue re-open a
  /// run the student started in a lecture.
  roomId         String?
  room           SimRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// The RNG seed for a stochastic simulator, assigned once when the run opens.
  ///
  /// Not a convenience. `lib/sim/engine/stochastic.ts` threads a seeded
  /// generator through every draw precisely so the promise the rest of lib/sim
  /// makes — a pinned report reads the same next month — survives randomness.
  /// Without this column the debrief's replay and its counterfactuals would be
  /// a plausible story rather than the run the student actually played.
  /// Null on the authored formats, which draw nothing.
  seed           String?

  /// Format-specific run state, as JSON.
  ///
  /// The war room keeps its decisions in the four typed columns above and uses
  /// this only for the hypothesis revision log — history the columns cannot
  /// hold, because they hold the current belief and are overwritten by it.
  ///
  /// A second format does not have a hypothesis, a diagnosis or a single
  /// allocation — the turnaround format has a schedule of them, one per period,
  /// and a cursor saying which period is open. Widening those four columns to
  /// cover both would give every war-room row three nullable fields it never
  /// uses and no type safety in either direction, so the format that needs a
  /// different shape carries its own and the original columns stay honest.
  stateJson      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  committedAt    DateTime?

  purchases      SimPurchase[]
  messages       SimMessage[]
  result         SimResult?

  @@index([userId])
  @@index([questionId])
  @@index([phase])
  @@index([roomId])
}

/// A professor-hosted classroom exercise.
///
/// The room is coordination and entitlement, nothing else: students play
/// ordinary `SimRun`s that happen to carry its id, so scoring, XP, the
/// leaderboard and the whole `lib/sim` engine are untouched by its existence.
/// That is the entire design. A room that owned a shared run would have had to
/// answer whose hypothesis it was.
///
/// It points at a `Question` rather than a scenario slug because `questionId` is
/// what `recordFirstResult` and `simStateByQuestion` key on — pinning the room
/// to the same catalogue row is what keeps a class run indistinguishable from
/// any other run everywhere downstream.
model SimRoom {
  id           String    @id @default(cuid())

  /// The code read out in class, uppercase. Its alphabet excludes O/0/I/1 (see
  /// lib/rooms/code.ts): it is transcribed off a projector by sixty people at
  /// once, and a code that needs a spelling correction has failed.
  code         String    @unique
  /// scrypt via lib/password.ts. A room password is a password, and storing it
  /// in the clear so the console could redisplay it is not a trade worth making
  /// — the host re-sets it instead.
  passwordHash String
  name         String

  hostId       String
  host         User      @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)

  /// The war room the host picked from the catalogue.
  questionId   String
  question     Question  @relation(fields: [questionId], references: [id])

  /// "open" | "closed" — see ROOM_STATUSES in lib/types.ts. Closing stops new
  /// joins and new runs and deliberately leaves runs already under way alone.
  status       String    @default("open")
  closedAt     DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members      SimRoomMember[]
  runs         SimRun[]

  @@index([hostId])
}

/// One student's seat in a room.
///
/// The row that grants access: `roomGrant` reads these to decide which single
/// question a non-Pro student may open, which is why it is a real row rather
/// than something derived from having a run — the grant has to exist BEFORE the
/// run does, or the first click would be refused.
model SimRoomMember {
  id          String   @id @default(cuid())
  roomId      String
  room        SimRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Typed at the door. Kept apart from `User.name` so a signed-in student can
  /// appear as "Roll 42" on one professor's roster without renaming their
  /// account across the app. For a guest row the two are set together, since a
  /// roster full of "Guest" is not a roster.
  displayName String

  joinedAt    DateTime @default(now())

  /// One seat per person per room. This constraint is what makes re-joining
  /// idempotent — an upsert against it turns a refreshed join form into a no-op
  /// instead of a second row on the roster.
  @@unique([roomId, userId])
  @@index([userId])
}

model SimPurchase {
  id          String   @id @default(cuid())
  runId       String
  run         SimRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  drilldownId String
  /// Price at purchase time. Authored costs get retuned; a past run's
  /// efficiency score must not move underneath it.
  cost        Int
  /// 1-based purchase order, so "cheaply AND early" is answerable.
  seq         Int
  createdAt   DateTime @default(now())

  /// The one integrity rule worth a constraint: a double-click must not be
  /// charged twice for the same cut.
  @@unique([runId, drilldownId])
  @@index([runId])
}

model SimResult {
  id            String   @id @default(cuid())
  runId         String   @unique
  run           SimRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  overall       Int
  band          String   // see simBands in lib/config/simulation.ts

  /// Which format produced this result, so the report knows how to read the
  /// scores below. Defaults to the only format that existed when the column was
  /// added, which is exactly what every historical row was.
  formatSlug    String   @default("war-room")

  /// JSON Record<string, number> — the format's rubric dimensions, keyed by its
  /// own rubric keys.
  ///
  /// The five typed columns below CANNOT hold a second format's scores: they are
  /// named after the war room's dimensions. Rather than rename them to something
  /// generic and lose the readability that lets the report iterate the rubric and
  /// index by key, a format with different dimensions writes here and leaves them
  /// alone. `overall` stays format-agnostic and is what the leaderboard and the
  /// percentile rank read, so nothing downstream needs to know which format ran.
  scoresJson    String   @default("{}")

  /// Column names mirror the simRubric keys exactly, so the report can iterate
  /// the rubric and index by key. Unlike Evaluation these are non-null: every
  /// run passes through every phase, so no dimension is ever "not applicable".
  ///
  /// Written by the war-room format only. A turnaround result stores zero here
  /// and its real scores in `scoresJson` — see `formatSlug`.
  hypothesis    Int
  investigation Int
  diagnosis     Int
  decision      Int
  outcome       Int

  causeFound    Boolean  @default(false)
  daysSpent     Int
  daysPar       Int

  /// JSON SimOutcomeResult — this run's quarterly paths, the do-nothing
  /// counterfactual and the authored best. PINNED rather than recomputed on
  /// read: the causal model is code, so re-deriving would let a later content
  /// edit silently rewrite a student's history.
  outcomeJson   String   @default("{}")
  /// JSON FeedbackItem[] — the same shape as Evaluation.feedback.
  feedback      String   @default("[]")

  createdAt     DateTime @default(now())
}

/// Debrief chat. Kept apart from Message so the interview transcript queries —
/// solutionWasRevealed, the evaluator, updateProgress — can never see a
/// simulation turn.
model SimMessage {
  id        String   @id @default(cuid())
  runId     String
  run       SimRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  /// Which engine produced an assistant turn, so the degraded-answer badge
  /// survives a reload. Same contract as Message.provider.
  provider  String?
  model     String?
  createdAt DateTime @default(now())

  @@index([runId])
}

model QuestionFeedback {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  attemptId  String?
  type       String   // "WrongAnswer" | "Typo" | "Unclear" | "FactualError" | "Inappropriate" | "Other"
  message    String?
  status     String   @default("Open") // "Open" | "Reviewing" | "Resolved" | "Dismissed"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([questionId])
}

/// An admin's edits to an authored scenario's driver graph.
///
/// The scenarios in `lib/sim/scenarios` stay the shipped default; a row here is
/// an OVERRIDE of one, keyed by slug. That ordering is deliberate: the app runs
/// correctly against an empty table, the test suite goes on exercising the real
/// authored numbers, and a bad edit is undone by deleting the row rather than by
/// restoring content from a backup.
///
/// Only `drivers` is overridable. Causes, drilldowns and interventions reference
/// driver ids, so letting both sides move at once turns one bad save into a
/// scenario that no longer type-checks against itself — `lib/sim/overlay.ts`
/// re-validates the merged scenario and falls back to code if it doesn't hold.
model SimScenarioOverride {
  id          String   @id @default(cuid())
  /// Matches SimScenario.slug. Not a foreign key: scenarios live in code, so
  /// there is no row to point at.
  slug        String   @unique
  /// JSON SimDriver[] — the complete replacement driver graph, not a patch.
  /// Stored whole so a save is atomic and a diff against code is readable.
  drivers     String
  /// Why the admin changed it. Shown in the editor beside the reset control.
  note        String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
